CREATE TABLE `rakaminkfanalytics-510502.kimia_farma.kf_tabel_analisa` AS
SELECT
  -- Data transaksi
  t.transaction_id,
  -- kolom date di CSV berformat M/D/YYYY -> ubah ke tipe DATE
  COALESCE(
    SAFE.PARSE_DATE('%m/%d/%Y', CAST(t.date AS STRING)),
    SAFE_CAST(t.date AS DATE)
  ) AS date,


  -- Data cabang
  t.branch_id,
  c.branch_name,
  c.kota,
  c.provinsi,
  c.rating AS rating_cabang,


  -- Data customer & produk
  t.customer_name,
  t.product_id,
  p.product_name,
  t.price AS actual_price,
  t.discount_percentage,


  -- Persentase laba berdasarkan harga obat
  CASE
    WHEN t.price <= 50000  THEN 0.10
    WHEN t.price <= 100000 THEN 0.15
    WHEN t.price <= 300000 THEN 0.20
    WHEN t.price <= 500000 THEN 0.25
    ELSE 0.30
  END AS persentase_gross_laba,


  -- nett_sales = harga setelah diskon
  t.price * (1 - t.discount_percentage) AS nett_sales,


  -- nett_profit = nett_sales x persentase gross laba
  t.price * (1 - t.discount_percentage) *
  CASE
    WHEN t.price <= 50000  THEN 0.10
    WHEN t.price <= 100000 THEN 0.15
    WHEN t.price <= 300000 THEN 0.20
    WHEN t.price <= 500000 THEN 0.25
    ELSE 0.30
  END AS nett_profit,


  t.rating AS rating_transaksi


FROM `rakaminkfanalytics-510502.kimia_farma.kf_final_transaction` AS t
LEFT JOIN `rakaminkfanalytics-510502.kimia_farma.kf_kantor_cabang` AS c
  ON t.branch_id = c.branch_id
LEFT JOIN `rakaminkfanalytics-510502.kimia_farma.kf_product` AS p
  ON t.product_id = p.product_id;

